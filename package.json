{
  "name": "asar-desktop",
  "version": "2.1.2",
  "description": "اثر — مدیریت تجربه‌های فرهنگی شخصی",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node test/run-desktop.cjs"
  },
  "keywords": [],
  "author": "GriefKid",
  "license": "ISC",
  "build": {
    "appId": "com.griefkid.mylife",
    "productName": "اثر",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "اثر",
      "artifactName": "Asar-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload.cjs",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "executableName": "Asar"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.39.0",
    "adm-zip": "^0.6.1",
    "electron-store": "^8.2.0",
    "pdfjs-dist": "4.10.38"
  }
}
